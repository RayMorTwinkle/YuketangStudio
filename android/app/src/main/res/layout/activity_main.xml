<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:background="#f7f9fc">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_media_rew"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="后退" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_media_ff"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="前进" />

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="刷新" />

        <Spinner
            android:id="@+id/envSpinner"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:minWidth="0dp" />

        <ImageButton
            android:id="@+id/btnDesktop"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_menu_view"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="桌面端切换" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_menu_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="菜单" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#607190"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="YKT" />
    </LinearLayout>

    <!-- 多标签条：多于一个标签或需要新建时出现 -->
    <HorizontalScrollView
        android:id="@+id/tabStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#eef1f6"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tabStripInner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="3dp" />
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/pageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/tabContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 隐藏收集页 WebView 容器：历史课件批量导入时脚本会 GM_openInTab 打开收集页 -->
        <FrameLayout
            android:id="@+id/collectContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 缩放控制条（菜单里「显示大小」唤出） -->
        <LinearLayout
            android:id="@+id/zoomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#f7f9fc"
            android:padding="6dp"
            android:layout_gravity="bottom"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="显示大小"
                android:textSize="12sp"
                android:paddingEnd="8dp" />

            <SeekBar
                android:id="@+id/zoomSeek"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="150"
                android:progress="50" />

            <TextView
                android:id="@+id/zoomLabel"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textSize="12sp"
                android:gravity="center" />

            <Button
                android:id="@+id/zoomReset"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="重置"
                android:textSize="12sp" />

            <Button
                android:id="@+id/zoomDone"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="完成"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

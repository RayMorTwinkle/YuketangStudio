<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 工具栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@color/toolbar_bg">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_rew"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="后退" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_ff"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="前进" />

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="刷新" />

        <TextView
            android:id="@+id/btnEnv"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="长江雨课堂 ▾"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackground"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:paddingStart="2dp"
            android:paddingEnd="4dp"
            android:maxWidth="72dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="YKT" />

        <ImageButton
            android:id="@+id/btnDesktop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_view"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="桌面端切换" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="菜单" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 多标签条：圆角 chip + 显式关闭 × -->
    <HorizontalScrollView
        android:id="@+id/tabStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tabstrip_bg"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabStripInner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp" />
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/pageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressTint="@color/brand"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/tabContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 隐藏收集页 WebView 容器 -->
        <FrameLayout
            android:id="@+id/collectContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 缩放控制条 -->
        <LinearLayout
            android:id="@+id/zoomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_zoombar"
            android:padding="10dp"
            android:layout_gravity="bottom"
            android:elevation="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="页面缩放"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:paddingEnd="8dp" />

            <SeekBar
                android:id="@+id/zoomSeek"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="50" />

            <TextView
                android:id="@+id/zoomLabel"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textSize="12sp"
                android:textColor="@color/brand"
                android:gravity="center" />

            <Button
                android:id="@+id/zoomReset"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="重置"
                android:textSize="12sp" />

            <Button
                android:id="@+id/zoomDone"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="完成"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
